# Central knobs for the demo. Sourced by every script. Override any of these in your shell,
# e.g.  MINIKUBE_MEMORY=8192 task up

# --- host (control-plane) cluster ---------------------------------------------------------
: "${MINIKUBE_PROFILE:=byoc-control-plane}"   # minikube profile name = the control-plane cluster
: "${MINIKUBE_CPUS:=4}"
: "${MINIKUBE_MEMORY:=8192}"          # MB. argocd + principal + N vclusters is not tiny.
: "${MINIKUBE_DRIVER:=docker}"        # docker is the safe default; kvm2/podman also fine
: "${MINIKUBE_K8S_VERSION:=stable}"

# --- gitops source of truth ---------------------------------------------------------------
# ArgoCD (host + each vcluster) pulls the chart and client files from this git repo.
# Defaults to this repo's own origin remote; override to a fork you can push to.
: "${REPO_URL:=$(git -C "${DEMO_ROOT:-.}" remote get-url origin 2>/dev/null || echo "https://github.com/REPLACE_ME/byoc-demo.git")}"
# Argo CD clones a PUBLIC repo anonymously over HTTPS, so normalize an SSH origin to HTTPS.
case "${REPO_URL}" in
  git@*)       REPO_URL="https://$(printf '%s' "${REPO_URL#git@}" | sed 's/:/\//')" ;;
  ssh://git@*) REPO_URL="https://${REPO_URL#ssh://git@}" ;;
esac
# symbolic-ref --short works before the first commit and stays quiet when detached, so it never
# leaks a stray "HEAD" line the way `rev-parse --abbrev-ref` does on an unborn branch.
: "${REPO_REVISION:=$(git -C "${DEMO_ROOT:-.}" symbolic-ref --short -q HEAD 2>/dev/null || echo main)}"

# --- argocd-agent -------------------------------------------------------------------------
: "${ARGOCD_AGENT_VERSION:=v0.10.0}"  # matches the pinned argocd-agentctl in flake.nix
: "${ARGOCD_NS:=argocd}"
# NodePorts on the minikube node so agents (inside vclusters) can dial the principal by node IP.
# This is the whole "reach out, don't reach in": agents dial these; nothing dials into a client.
: "${PRINCIPAL_GRPC_NODEPORT:=30443}"     # -> principal gRPC 8443
: "${RESOURCE_PROXY_NODEPORT:=30909}"     # -> resource proxy 9090

# --- clients ------------------------------------------------------------------------------
# Seed clients brought up by `task up`. Each must have a matching clients/<name>.yaml.
: "${SEED_CLIENTS:=rich-client globex}"

# --- lane -> image tag mapping ------------------------------------------------------------
# Used by scripts when they need the tag directly (the ApplicationSet gets it from the chart's
# values.<lane>.yaml overlay instead).
lane_to_tag() {
  case "$1" in
    latest) echo "latest" ;;
    stable) echo "0.90.4" ;;
    lts)    echo "0.71.2" ;;
    *) echo "ERROR: unknown lane '$1'" >&2; return 1 ;;
  esac
}
