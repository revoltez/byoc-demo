#!/usr/bin/env bash
# direnv entrypoint. `direnv allow` once, then every `cd` into this repo loads the
# pinned toolchain (k3d, vcluster, argocd, argocd-agentctl, helm, task, ...).

if has nix; then
  use flake
else
  echo "nix not found. Install nix (with flakes) or run the tools yourself." >&2
fi

# Keep all cluster state repo-local so the demo never touches your real ~/.kube.
export KUBECONFIG="$PWD/.kube/config"
mkdir -p "$PWD/.kube"
